+#if defined(XHD_ONLY_RUNTIME) && defined(_WIN32) && defined(__x86_64__)
+// Diagnostic only: execute the same mutex implementation on a dedicated host stack.
+// Do not clone draw objects, skip invalid nodes, or change guest synchronization.
+struct XhdMutexStack {
+    void* memory = VirtualAlloc(nullptr, 2 * 1024 * 1024, MEM_RESERVE | MEM_COMMIT,
+                               PAGE_READWRITE);
+    bool active = false;
+    ~XhdMutexStack() { if (memory) VirtualFree(memory, 0, MEM_RELEASE); }
+};
+struct XhdMutexCall {
+    PthreadMutexT* mutex;
+    s32 (PS4_SYSV_ABI *function)(PthreadMutexT*);
+    s32 result;
+};
+static void* PS4_SYSV_ABI XhdMutexEntry(void* raw) {
+    auto* call = static_cast<XhdMutexCall*>(raw);
+    call->result = call->function(call->mutex);
+    return nullptr;
+}
+static s32 PS4_SYSV_ABI XhdMutexInvoke(PthreadMutexT* mutex,
+                                     s32 (PS4_SYSV_ABI *function)(PthreadMutexT*)) {
+    thread_local XhdMutexStack stack;
+    if (stack.active) return function(mutex);
+    if (!stack.memory) std::abort();
+    XhdMutexCall call{mutex, function, 0};
+    stack.active = true;
+    _runOnAnotherStack(&call, reinterpret_cast<void*>(XhdMutexEntry),
+                      static_cast<char*>(stack.memory) + 2 * 1024 * 1024 - 64);
+    stack.active = false;
+    return call.result;
+}
+static s32 PS4_SYSV_ABI XhdMutexLock(PthreadMutexT* mutex) {
+    return XhdMutexInvoke(mutex, posix_pthread_mutex_lock);
+}
+static s32 PS4_SYSV_ABI XhdMutexUnlock(PthreadMutexT* mutex) {
+    return XhdMutexInvoke(mutex, posix_pthread_mutex_unlock);
+}
+#endif
